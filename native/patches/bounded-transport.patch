+async fn handle_ipc(ipc: NamedPipeClient, mut ipc_rx: Receiver<ipc::PacketWithMeta>, tx: Sender<Event>) -> Result<()> {
+    // Independent read/write futures prevent a circular wait between bounded queues.
+    let (mut reader, mut writer) = tokio::io::split(ipc);
+    let read = async {
+        let mut buf = [0u8; IPC_BUF_SIZE];
+        loop {
+            let len = reader.read(&mut buf).await?;
+            if len == 0 { return Err(anyhow!("inspection host disconnected")); }
+            let FromProxy { message: Some(message) } = FromProxy::decode(&buf[..len])? else {
+                return Err(anyhow!("invalid host message"));
+            };
+            tx.send(Event::Ipc(message)).await?;
         }
-    }
+        #[allow(unreachable_code)] Ok::<(), anyhow::Error>(())
+    };
+    let write = async {
+        while let Some(packet) = ipc_rx.recv().await {
+            let buf = packet.encode_to_vec();
+            writer.write_all(&buf).await?;
+        }
+        Err::<(), anyhow::Error>(anyhow!("packet queue closed"))
+    };
+    tokio::try_join!(read, write)?;
+    Ok(())
 }
 
